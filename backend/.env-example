DB_DIALECT=mysql
DB_DATABASE=ql_phong_tro_dev
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# true = Sequelize tự ALTER bảng khi model đổi (CHỈ dùng ở dev).
# Để trống/false thì phải chạy `node database/fix_db.js` để cập nhật schema.
DB_SYNC_ALTER=false

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://nextjs:3000

# Bắt buộc: chuỗi ngẫu nhiên đủ dài, KHÔNG commit giá trị thật.
# Tạo mới: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# local | cloudinary
IMAGE_STORAGE=local

# Web Push (WebPush)
# Tạo cặp khóa: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartrent.dev
